# ==============================================================================
# Swarmmy Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and insert your actual API keys:
#
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# Only the providers you intend to use need to be filled in.
# ==============================================================================

# Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Groq Cloud (Free high-speed Llama 3.3 at https://console.groq.com/)
GROQ_API_KEY=

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Mistral AI (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Cohere (https://dashboard.cohere.com/)
COHERE_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Hugging Face User Access Token (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Azure OpenAI (if applicable)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
